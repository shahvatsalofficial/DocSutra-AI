{
  "name": "docsutra-ai",
  "version": "0.2.0",
  "description": "Offline documentation auditor: verifies links, anchors, commands, accessibility and leaked secrets in Markdown, and ships 16 portable AI agent skills. No API key, no network, nothing executed.",
  "keywords": ["documentation", "docs", "markdown", "linter", "link-checker", "broken-links", "anchors", "audit", "accessibility", "secrets", "cli", "sarif", "agent-skills", "claude-code", "cursor", "codex", "gemini-cli", "copilot", "mcp-alternative", "docs-as-code", "ai-agents", "documentation-testing"],
  "homepage": "https://github.com/shahvatsalofficial/DocSutra-AI#readme",
  "bugs": { "url": "https://github.com/shahvatsalofficial/DocSutra-AI/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/shahvatsalofficial/DocSutra-AI.git" },
  "author": "Vatsal Shah <vatsalshah1212@gmail.com> (https://github.com/shahvatsalofficial)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "docsutra": "./packages/cli/index.mjs", "docsutra-ai": "./packages/cli/index.mjs" },
  "main": "./packages/index.mjs",
  "exports": { ".": "./packages/index.mjs", "./package.json": "./package.json" },
  "files": ["packages", ".agents/skills", "agents", "schemas", "policies", "scripts/install.sh", "scripts/install.ps1", "scripts/install.cmd", "docsutra.config.json", "README.md", "LICENSE", "NOTICE", "CHANGELOG.md", "SECURITY.md", "llms.txt"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "build:evidence": "node scripts/build-evidence.mjs",
    "scan:self": "node packages/cli/index.mjs scan --root . --out-dir .docsutra",
    "scan:demo": "node packages/cli/index.mjs scan --root examples/demo-repo --out-dir .docsutra/demo",
    "scan:healthy": "node packages/cli/index.mjs scan --root examples/healthy-repo --out-dir .docsutra/healthy",
    "doctor": "node packages/cli/index.mjs doctor",
    "prepublishOnly": "npm test"
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" }
}
